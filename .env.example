# ============================================================================
# Tianshu (天枢) - 环境变量配置示例
# ============================================================================
#
# 使用方式：
#   1. 复制此文件为 .env: cp .env.example .env
#   2. 根据实际情况修改配置
#   3. 使用 docker-compose up -d 启动服务
#
# ============================================================================

# ----------------------------------------------------------------------------
# 应用配置
# ----------------------------------------------------------------------------
API_PORT=8080
WORKER_PORT=8001
MCP_PORT=8002
FRONTEND_PORT=80

LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# JWT 认证配置
# ----------------------------------------------------------------------------
# 重要：生产环境请修改为随机字符串！
# 生成方式: openssl rand -hex 32
# ⚠️  当 ENV=production 或 REQUIRE_SECRETS=true 时，若 JWT_SECRET_KEY 仍为占位符将启动失败(fail-fast)。
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ----------------------------------------------------------------------------
# 运行模式与密钥强制校验
# ----------------------------------------------------------------------------
# ENV=production（或 REQUIRE_SECRETS=true）开启「生产模式」：
#   启动时强制校验 JWT_SECRET_KEY 非占位符、MinIO 凭据非弱口令，否则 fail-fast 拒绝启动。
ENV=
REQUIRE_SECRETS=false

# ----------------------------------------------------------------------------
# 文件签名 URL（本地 /api/v1/files 访问鉴权）
# ----------------------------------------------------------------------------
# 本地输出/源文件通过 HMAC 签名 URL 访问（浏览器 <img> 可直接用）。
# FILE_URL_SECRET 未设置时回落到 JWT_SECRET_KEY；FILE_URL_TTL 为签名有效期(秒)。
FILE_URL_SECRET=
FILE_URL_TTL=3600

# ----------------------------------------------------------------------------
# CORS 配置
# ----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# ----------------------------------------------------------------------------
# GPU 配置
# ----------------------------------------------------------------------------
# GPU 数量（Docker 分配）
GPU_COUNT=1

# 可见的 GPU 设备（Backend，逗号分隔）
CUDA_VISIBLE_DEVICES=0

# 每个 GPU 的 Worker 数量
WORKER_GPUS=2

# Worker 批处理大小
MAX_BATCH_SIZE=4

# Worker 超时时间（秒）
WORKER_TIMEOUT=300

# Worker 内存限制（硬限制，超过此值容器会被 OOM Killer 杀死）
# 格式: 数字 + 单位（M/G），例如: 8G, 16G, 32G
# 建议根据服务器内存配置：
#   - 16GB 服务器: 8G
#   - 32GB 服务器: 16G
#   - 64GB 服务器: 32G
WORKER_MEMORY_LIMIT=16G

# Worker 内存软限制（保证最少可用内存）
# 建议设置为硬限制的 50-75%
WORKER_MEMORY_RESERVATION=8G

# ----------------------------------------------------------------------------
# 文件配置
# ----------------------------------------------------------------------------
# 最大文件大小（字节，0 表示不限制）
MAX_FILE_SIZE=0

# Nginx 文件上传大小限制（0 表示不限制）
NGINX_CLIENT_MAX_BODY_SIZE=0

# ----------------------------------------------------------------------------
# PDF 拆分配置（大文件并行处理）
# ----------------------------------------------------------------------------
# 是否启用 PDF 自动拆分（true/false）
PDF_SPLIT_ENABLED=true

# PDF 拆分阈值（页数）
# 超过此页数的 PDF 会自动拆分为多个子任务并行处理
# 建议值: 500-1000 页
PDF_SPLIT_THRESHOLD_PAGES=500

# PDF 拆分块大小（页数）
# 每个子任务处理的页数
# 建议值: 300-500 页（根据服务器内存调整）
PDF_SPLIT_CHUNK_SIZE=250

# ----------------------------------------------------------------------------
# 数据库配置
# ----------------------------------------------------------------------------
DATABASE_PATH=/app/data/db/mineru_tianshu.db

# ----------------------------------------------------------------------------
# 模型下载配置
# ----------------------------------------------------------------------------
# 模型来源:
#   - local: 默认启动仅使用 backend/model 下的本地模型，不自动下载
#   - auto/modelscope/huggingface: 仅手动下载模型时使用
MODEL_DOWNLOAD_SOURCE=local

# HuggingFace 镜像地址（国内加速）
HF_ENDPOINT=https://hf-mirror.com

# MinerU 虚拟显存大小（GB，auto 表示自动检测）
# MINERU_VIRTUAL_VRAM_SIZE=6

# 离线模型外部目录（主机路径，需包含预下载的所有模型文件），仅用于离线部署 docker-compose.offline.yml
OFFLINE_MODELS_PATH=./models-offline

# ----------------------------------------------------------------------------
# MinIO 对象存储配置（可选）
# ----------------------------------------------------------------------------
# MinIO 是一个 S3 兼容对象存储服务，用于存储和分发图片
#
# 启用/禁用 MinIO（true=启用，false=禁用）
# - true:  使用 MinIO 存储图片
# - false: 使用本地文件服务（兼容所有 CPU）
#
# 默认: true
MINIO_ENABLED=true

# MinIO 服务地址（容器内部）
MINIO_ENDPOINT=minio:9000

# MinIO 访问密钥（生产环境请修改！）
# ⚠️  生产环境(ENV=production / REQUIRE_SECRETS=true)下若仍为 minioadmin 等弱口令会启动失败(fail-fast)。
#     强随机生成示例: openssl rand -hex 16
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# MinIO 存储桶名称
MINIO_BUCKET=ts-img

# MinIO 是否使用 HTTPS
MINIO_SECURE=false

# MinIO 公开访问 URL（外部访问地址）
#
# ⚠️  重要：仅在 MINIO_ENABLED=true 时需要配置
#     必须设置为外部可访问的完整 URL
#
# 配置示例:
#   - 局域网: MINIO_PUBLIC_URL=http://192.168.1.100:9000
#   - 公网: MINIO_PUBLIC_URL=http://your-domain.com:9000
#   - HTTPS: MINIO_PUBLIC_URL=https://files.your-domain.com
#   - Windows/WSL: 使用 Windows 主机的 IP (在 Windows 中运行 ipconfig 查看)
#
# 获取 Windows IP 的方法:
#   1. 在 Windows PowerShell 或 CMD 中运行: ipconfig
#   2. 找到 "IPv4 地址"，例如: 192.168.1.100
#   3. 设置: MINIO_PUBLIC_URL=http://192.168.1.100:9000
#
MINIO_PUBLIC_URL=http://192.168.1.100:9000

# MinIO 服务端口
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# MinIO 预签名 URL 有效期（秒，默认 3600=1小时）
#
# 任务图片桶为私有：API 每次返回结果时「读时现签」一条临时 presigned URL（不把永久 URL 存盘）。
# 浏览器凭该 URL 直接访问 MinIO，超过此时长后链接失效。
#   - 调大（如 86400=1天）：链接更耐用、跨次打开更易命中缓存；但泄露后的有效窗口也更长。
#   - 调小：更安全，但图片可能在浏览期间过期需刷新。
MINIO_PRESIGN_TTL=3600

# ----------------------------------------------------------------------------
# MCP Server 配置（可选）
# ----------------------------------------------------------------------------
API_URL=http://backend:8000

# ----------------------------------------------------------------------------
# Redis 队列配置（可选 - 解决 SQLite 并发瓶颈）
# ----------------------------------------------------------------------------
# 是否启用 Redis 队列（true/false）
# 默认: false（使用 SQLite 队列）
# 启用后可以提升高并发场景下的性能
#
# 使用方式:
#   1. 设置 REDIS_QUEUE_ENABLED=true
#   2. 启动 Docker 时使用: docker-compose --profile redis up -d
#   3. 不使用 --profile redis 时，Redis 容器不会启动
#
REDIS_QUEUE_ENABLED=false

# Redis 服务器配置（仅在 REDIS_QUEUE_ENABLED=true 时生效）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ----------------------------------------------------------------------------
# 并发与可靠性
# ----------------------------------------------------------------------------
# 每个设备的 Worker 并发数（优先级高于 start_all 的 --workers-per-device）。
# 多 Worker 建议配合 SQLite WAL（已默认开启）或 Redis 队列，避免显存与锁竞争。
MAX_CONCURRENT_TASKS=1

# 超时任务最大重试次数：超过后标记 failed，避免无限重试占用 Worker。
MAX_RETRY=3

# Worker 处理中任务的心跳间隔（秒），用于 Redis 队列的超时恢复续约。
WORKER_HEARTBEAT_INTERVAL=60

# start_all 子进程崩溃后的最大重启次数（指数退避），超过才整体停服。
SERVICE_MAX_RESTARTS=5

# ----------------------------------------------------------------------------
# 前端配置
# ----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
